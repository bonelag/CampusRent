            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Phòng trọ rất thoáng mát, an ninh tốt, gần trường NEU đi lại tiện lợi.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms/{{sampleRoomId}}/reviews",
              "host": [
