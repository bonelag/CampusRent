    {
      "name": "2. Rooms",
      "item": [
        {
          "name": "Tìm kiếm và lọc phòng trọ",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms?keyword=Bách Khoa&page=1&pageSize=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rooms"
              ],
              "query": [
                {
                  "key": "keyword",
                  "value": "Bách Khoa"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Chi tiết phòng trọ (Kèm reviews và rating)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms/{{sampleRoomId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rooms",
                "{{sampleRoomId}}"
              ]
            }
          }
        },
        {
          "name": "Dự toán chi phí sinh hoạt (Living Cost)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms/{{sampleRoomId}}/cost-estimate?expectedKwh=80&expectedM3=4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rooms",
                "{{sampleRoomId}}",
                "cost-estimate"
              ],
              "query": [
                {
                  "key": "expectedKwh",
                  "value": "80"
                },
                {
                  "key": "expectedM3",
                  "value": "4"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Reviews (TV4)",
      "item": [
        {
          "name": "Gửi đánh giá hợp lệ (1-5 sao)",
