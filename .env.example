# Copy to .env; replace every CHANGE_ME value before deployment.
POSTGRES_PASSWORD=CHANGE_ME_database_password
JWT_SECRET=CHANGE_ME_generate_at_least_32_random_bytes
ADMIN_EMAIL=admin@your-domain.vn
ADMIN_PASSWORD=CHANGE_ME_admin_password_minimum_12_characters
CLIENT_URL=http://localhost:8080
APP_PORT=8080
# Optional: without these, landlords can use HTTPS image URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: enables Google Maps-quality address autocomplete. Restrict this server key to Places API.
GOOGLE_PLACES_API_KEY=

