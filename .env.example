# Copy to .env for local Docker Compose. Never commit real credentials.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_BYTES
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_UNIQUE_ADMIN_PASSWORD
CLIENT_URL=http://localhost:8080
APP_PORT=8080
WEB_BIND=127.0.0.1

# For an existing external PostgreSQL database, use deploy.sh and compose.production.yaml.

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_PLACES_API_KEY=
