@{
    ViewData["Title"] = "Chi tiết phòng trọ";
}

<div class="row">
    <div class="col-md-8">
        <h2 class="fw-bold">Phòng khép kín ban công thoáng gần Bách Khoa</h2>
        <p class="text-muted"><i class="bi bi-geo-alt"></i> Số 15 ngõ 30 Tạ Quang Bửu, Hai Bà Trưng, Hà Nội</p>
        
        <div class="mb-4">
            <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=1000" class="img-fluid rounded shadow-sm w-100" style="max-height: 400px; object-fit: cover;" alt="Room image" />
        </div>

        <div class="card p-3 mb-4 shadow-sm">
            <h5 class="fw-bold">Mô tả chi tiết</h5>
            <p>Phòng 25m2 full đồ: điều hòa, nóng lạnh, giường tủ, máy giặt chung. Ngõ ô tô đỗ cửa, cách cổng Parabol Bách Khoa chỉ 600m.</p>
        </div>

        <!-- Bảng tính dự toán chi phí sinh hoạt (jQuery) -->
        <div class="card p-4 mb-4 shadow-sm border-primary">
            <h5 class="fw-bold text-primary">📊 Dự toán chi phí sinh hoạt hàng tháng</h5>
            <p class="text-muted small">Kéo thanh trượt để ước tính tổng tiền cần trả mỗi tháng.</p>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Số điện dự kiến: <span id="electricKwhDisplay" class="text-primary">80</span> kWh</label>
                    <input type="range" class="form-range" id="electricRange" min="0" max="300" value="80">
                    <small class="text-muted">Đơn giá: 3.800 đ/kWh</small>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Khối nước dự kiến: <span id="waterM3Display" class="text-primary">4</span> m³</label>
                    <input type="range" class="form-range" id="waterRange" min="0" max="20" value="4">
                    <small class="text-muted">Đơn giá: 30.000 đ/m³</small>
                </div>
            </div>
            <hr />
            <div class="d-flex justify-content-between align-items-center">
                <span class="fs-5">Tổng dự toán / tháng:</span>
                <span id="totalCostDisplay" class="fs-4 fw-bold text-danger">3.624.000 đ</span>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 shadow-sm sticky-top" style="top: 20px;">
            <h4 class="text-danger fw-bold">3.200.000 đ <small class="fs-6 text-muted">/ tháng</small></h4>
            <hr />
            <p class="mb-1"><strong>Chủ trọ:</strong> Bác Ba Chủ Trọ</p>
            <p class="mb-3"><strong>Số điện thoại:</strong> 0912345678</p>
            <button class="btn btn-primary w-100 mb-2">Đặt lịch xem phòng</button>
            <button class="btn btn-outline-danger w-100">Báo hết phòng</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const basePrice = 3200000;
            const electricPrice = 3800;
            const waterPrice = 30000;
            const internetPrice = 100000;
            const otherFee = 50000;

            function calculateTotal() {
                const kwh = parseInt($('#electricRange').val()) || 0;
                const m3 = parseInt($('#waterRange').val()) || 0;

                $('#electricKwhDisplay').text(kwh);
                $('#waterM3Display').text(m3);

                const total = basePrice + (kwh * electricPrice) + (m3 * waterPrice) + internetPrice + otherFee;
                $('#totalCostDisplay').text(total.toLocaleString('vi-VN') + ' đ');
            }

            $('#electricRange, #waterRange').on('input', calculateTotal);
        });
    </script>
}
