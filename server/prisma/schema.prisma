datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  LANDLORD
  ADMIN
}

enum PostStatus {
  AVAILABLE
  RENTED
  HIDDEN
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  fullName      String
  phoneNumber   String?
  avatar        String?
  role          Role      @default(STUDENT)
  isEduVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts         Post[]
  reviews       Review[]
  reports       Report[]
}

model Post {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title         String
  description   String      @db.Text
  address       String
  latitude      Float
  longitude     Float
  
  basePrice     Float
  electricPrice Float
  waterPrice    Float
  internetPrice Float       @default(0)
  otherFee      Float       @default(0)

  area          Float
  maxPeople     Int         @default(2)
  amenities     String[]
  images        String[]
  status        PostStatus  @default(AVAILABLE)
  
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  reviews       Review[]
  reports       Report[]
}

model Review {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating    Int
  comment   String   @db.Text
  isFlagged Boolean  @default(false)
  createdAt DateTime @default(now())

  reports   Report[]
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  reporter    User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId      String?
  post        Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewId    String?
  review      Review?      @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  
  reason      String
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
}
